---
import Layout from '../layouts/Layout.astro';
import Download from '../components/Download.astro';
import { APP_STORE_URL } from '../consts';

const title = 'GLPill — The free, private tracker for GLP-1 pills';
const description =
  "Every GLP-1 app wants your data — GLPill can't even see it. The free, private, pill-native iPhone tracker for Foundayo® (orforglipron), Rybelsus® and compounded orals: daily streaks, the 30-minute meal timer, weight trends, doctor-ready reports. Completely free, no account, no servers — your data never leaves your device.";

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GLPill',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS',
  description:
    "The private, pill-native iPhone tracker for GLP-1 pills — Foundayo (orforglipron), Rybelsus and compounded oral GLP-1s. Daily dose streaks, the 30-minute meal timer, weight trends and doctor-ready reports. No account, no servers — all data stays on your device.",
  // The app is free. This previously said 39.99, left over from the subscription
  // plan that was dropped before launch.
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: APP_STORE_URL,
  publisher: { '@type': 'Organization', name: 'GLPill', url: 'https://glpillapp.com' },
};

const features = [
  { emoji: '💊', h: 'Dose streaks', p: 'Log the daily pill in one tap. Watch the streak grow — consistency is the whole game with a daily GLP-1.' },
  { emoji: '⏱️', h: 'The 30-minute timer', p: 'On Rybelsus®? GLPill times the empty-stomach wait and tells you the exact minute you can eat.' },
  { emoji: '📉', h: 'Weight trends', p: 'Weigh-ins become a trend line with milestones — plus protein & water targets to protect your muscle.' },
  { emoji: '🩺', h: 'Doctor-ready reports', p: 'Adherence, dose steps, weight change and side effects in one summary you can share at your next appointment.' },
  { emoji: '🔒', h: 'Free & private by design', p: 'Completely free — no ads, no account, no analytics, no tracking. We run no servers and never see your data — it stays on your device and syncs privately through your own iCloud.' },
  { emoji: '☁️', h: 'Never lose your journey', p: 'Your history syncs privately across your devices and survives a reinstall or a new phone — through your own iCloud, never our servers.' },
  { emoji: '🧭', h: 'Your plan, tracked', p: 'Enter the dose plan your prescriber gave you and always know your current step. GLPill never suggests doses.' },
];
---

<Layout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appJsonLd)} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-teal to-mint px-5 py-20 text-center text-white sm:py-24">
    <img src="/icon.png" alt="GLPill app icon" width="96" height="96" class="mx-auto h-24 w-24 rounded-[22px] shadow-2xl" />
    <div class="mt-6">
      <span class="inline-block rounded-full border border-white/35 bg-white/15 px-4 py-1.5 text-sm font-semibold">Free on the App Store</span>
    </div>
    <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">The free, private tracker for GLP-1 pills</h1>
    <p class="mx-auto mt-4 max-w-2xl text-xl font-semibold text-white">
      Every GLP-1 app wants your data. This one can't even see it.
    </p>
    <p class="mx-auto mt-3 max-w-xl text-lg text-white/90">
      The free, pill-native tracker for Foundayo® (orforglipron), Rybelsus® and compounded oral GLP-1s — the streak,
      the 30-minute timer, doctor-ready reports. All on your iPhone, never our servers. No account, no ads.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={APP_STORE_URL} target="_blank" rel="noopener" class="rounded-full bg-white px-7 py-3.5 font-bold text-deep hover:bg-white/90">Download on the App Store</a>
      <a href="https://www.instagram.com/glpillapp/" target="_blank" rel="noopener" class="rounded-full border-2 border-white/70 px-7 py-3.5 font-bold text-white hover:bg-white/10">Follow @glpillapp</a>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="text-center text-2xl font-bold text-deep">One tap a day. Everything else is handled.</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-2xl bg-white p-6 shadow-sm">
          <div class="text-3xl">{f.emoji}</div>
          <h3 class="mt-3 font-bold text-deep">{f.h}</h3>
          <p class="mt-1.5 text-sm text-muted">{f.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Which pill -->
  <section class="mx-auto max-w-3xl px-5 py-8 text-center">
    <h2 class="text-2xl font-bold text-deep">Which pill are you on?</h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">GLPill is built for daily oral GLP-1s. See how it fits your routine:</p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <a href="/foundayo-tracker/" class="rounded-full bg-teal px-6 py-3 font-bold text-white hover:bg-deep">Foundayo (orforglipron) tracker →</a>
      <a href="/rybelsus-tracker/" class="rounded-full bg-deep px-6 py-3 font-bold text-white hover:bg-teal">Rybelsus tracker + 30-min timer →</a>
    </div>
    <p class="mt-4 text-sm"><a href="/glp1-pill-app/" class="font-semibold text-teal hover:underline">See how it works as the GLP-1 pill app →</a></p>
  </section>

  <!-- Guides -->
  <section class="mx-auto max-w-3xl px-5 py-8 text-center">
    <h2 class="text-2xl font-bold text-deep">New to the pill? Start here</h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">
      Plain-language, source-backed guides to taking Rybelsus, the Foundayo (orforglipron) dosing schedule,
      protein, side effects, and building a routine that sticks.
    </p>
    <a href="/blog/" class="mt-5 inline-block rounded-full bg-teal px-7 py-3 font-bold text-white hover:bg-deep">Read the GLP-1 pill guides →</a>
  </section>

  <!-- Screenshots -->
  <section class="mx-auto max-w-5xl px-5 py-16">
    <h2 class="text-center text-2xl font-bold text-deep">Built for the pill routine — not adapted from injections</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <img src="/shot-today.png" alt="GLPill Today screen with dose logged, 30-minute timer and streak" class="w-[min(280px,80vw)] rounded-[28px] shadow-2xl" />
      <img src="/shot-progress.png" alt="GLPill Progress screen with weight trend" class="w-[min(280px,80vw)] rounded-[28px] shadow-2xl" />
    </div>
  </section>

  <Download source="landing" />
</Layout>
