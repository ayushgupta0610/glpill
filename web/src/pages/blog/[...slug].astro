---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `https://glpillapp.com/blog/${post.id}/`;
const modified = d.dateModified ?? d.datePublished;

// Article schema — MedicalWebPage flavour for YMYL trust.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: d.title,
  description: d.description,
  datePublished: d.datePublished,
  dateModified: modified,
  author: { '@type': 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: 'GLPill', url: 'https://glpillapp.com', logo: { '@type': 'ImageObject', url: 'https://glpillapp.com/icon.png' } },
  mainEntityOfPage: url,
  image: 'https://glpillapp.com/icon.png',
  ...(d.sources.length ? { citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })) } : {}),
};
const faqLd = d.faqs.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
  : null;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://glpillapp.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://glpillapp.com/blog/' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
const fmtDate = (s) => new Date(s + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title={`${d.title} — GLPill`} description={d.description} path={`/blog/${post.id}/`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <article class="mx-auto max-w-2xl px-5 py-12">
    <nav class="text-sm text-muted" aria-label="Breadcrumb">
      <a class="hover:text-teal" href="/">Home</a> <span aria-hidden="true">›</span>
      <a class="hover:text-teal" href="/blog/">Guides</a> <span aria-hidden="true">›</span>
      <span class="text-ink">{d.title}</span>
    </nav>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-deep sm:text-4xl">{d.title}</h1>
    <p class="mt-3 text-sm text-muted">
      By {d.author} · Published {fmtDate(d.datePublished)}{d.dateModified ? ` · Updated ${fmtDate(d.dateModified)}` : ''}
    </p>

    <p class="mt-5 rounded-xl border border-teal/20 bg-white p-4 text-sm text-muted">
      <strong class="text-deep">Educational information, not medical advice.</strong> This guide is for general
      understanding of oral GLP-1 medicines. Always follow your prescriber's instructions and talk to a qualified
      clinician about your treatment.
    </p>

    <div class="prose prose-slate mt-8 max-w-none prose-headings:text-deep prose-a:text-teal">
      <Content />
    </div>

    {d.faqs.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold text-deep">Frequently asked questions</h2>
        <div class="mt-4 space-y-3">
          {d.faqs.map((f) => (
            <details class="group rounded-xl border border-teal/15 bg-white p-4">
              <summary class="cursor-pointer list-none font-semibold text-deep marker:hidden">{f.q}</summary>
              <p class="mt-2 text-sm text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-deep">Sources</h2>
        <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-muted">
          {d.sources.map((s) => (
            <li><a class="text-teal hover:underline" href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>
          ))}
        </ol>
      </section>
    )}

    <div class="mt-12 rounded-2xl bg-gradient-to-br from-teal to-mint p-6 text-center text-white">
      <p class="text-lg font-bold">Tracking an oral GLP-1?</p>
      <p class="mt-1 text-sm text-white/90">GLPill logs your daily pill, times the 30-minute wait, and charts your progress — privately.</p>
      <a href="/#waitlist" class="mt-4 inline-block rounded-full bg-white px-6 py-2.5 font-bold text-deep hover:bg-white/90">Get the app →</a>
    </div>

    <p class="mt-8 text-sm"><a class="text-teal hover:underline" href="/blog/">← All guides</a></p>
  </article>
</Layout>
