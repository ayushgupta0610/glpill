---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.datePublished) - +new Date(a.data.datePublished)
);

const pillars = [
  { key: 'orforglipron', label: 'Orforglipron / Foundayo' },
  { key: 'rybelsus', label: 'Rybelsus' },
  { key: 'oral-glp1', label: 'Oral GLP-1 basics' },
  { key: 'app', label: 'Using the app' },
];
const byPillar = (k) => posts.filter((p) => p.data.pillar === k);
---

<Layout
  title="GLP-1 Pill Guides — Oral GLP-1, Rybelsus & Orforglipron | GLPill"
  description="Plain-language, source-backed guides to oral GLP-1 medicines: how to take Rybelsus, the Foundayo (orforglipron) dosing schedule, side effects, protein, and building a routine that sticks."
  path="/blog/"
>
  <section class="mx-auto max-w-3xl px-5 py-14">
    <h1 class="text-3xl font-bold tracking-tight text-deep sm:text-4xl">GLP-1 pill guides</h1>
    <p class="mt-3 text-muted">Plain-language, source-backed guides to daily oral GLP-1s — Rybelsus®, Foundayo® (orforglipron), and compounded orals.</p>

    {pillars.map((pil) => {
      const list = byPillar(pil.key);
      return list.length > 0 ? (
        <div class="mt-10">
          <h2 class="text-sm font-bold uppercase tracking-wide text-teal">{pil.label}</h2>
          <ul class="mt-3 divide-y divide-teal/10 rounded-2xl bg-white shadow-sm">
            {list.map((p) => (
              <li>
                <a class="block px-5 py-4 hover:bg-cream" href={`/blog/${p.id}/`}>
                  <span class="font-semibold text-deep">{p.data.title}</span>
                  <span class="mt-1 block text-sm text-muted">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : null;
    })}

    {posts.length === 0 && <p class="mt-10 text-muted">Guides are on the way.</p>}
  </section>
</Layout>
